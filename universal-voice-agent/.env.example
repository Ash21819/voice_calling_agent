# ──────────────────────────────────────────────
# Universal Voice Agent Bridge — Environment Config
# ──────────────────────────────────────────────

# Server
PORT=3000
HOST=0.0.0.0

# OpenAI Realtime API
OPENAI_API_KEY=sk-...
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2024-12-17
OPENAI_VOICE=alloy
OPENAI_INSTRUCTIONS=You are a helpful AI voice agent. Be concise and friendly.

# Exotel Telephony
EXOTEL_API_KEY=your_exotel_api_key
EXOTEL_API_TOKEN=your_exotel_api_token
EXOTEL_SUBDOMAIN=your_subdomain.exotel.com

# SaaS Adapter Configuration
# Options: mock, webhook
SAAS_ADAPTER=mock

# Webhook Adapter (only if SAAS_ADAPTER=webhook)
WEBHOOK_URL=https://your-crm.com/api/webhook
WEBHOOK_SECRET=your_webhook_secret

# Audio Settings
INPUT_SAMPLE_RATE=8000
OUTPUT_SAMPLE_RATE=24000
INPUT_CHANNELS=1

# Logging
LOG_LEVEL=info
